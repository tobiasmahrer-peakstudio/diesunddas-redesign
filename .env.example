# --- GitHub ("database") ---------------------------------------------
# The repo the CMS reads from and writes to. Reads work with just
# OWNER/REPO (public repo, no token needed). Writes (the admin panel,
# image uploads, the contact form) need a token.
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=diesunddas-redesign
GITHUB_BRANCH=main

# Fine-grained Personal Access Token, scoped to ONLY this repo, with
# "Contents" permission set to Read and write. Create one at
# https://github.com/settings/tokens?type=beta
# Server-only — never expose this in client code or NEXT_PUBLIC_*.
GITHUB_TOKEN=

# --- Admin login ---------------------------------------------------
# A single shared admin password (no separate user accounts).
ADMIN_PASSWORD=change-me
# Random long string used to sign the login session cookie, e.g.
# generate one with: openssl rand -base64 32
SESSION_SECRET=

# --- Site ------------------------------------------------------------
# Used for sitemap.xml / canonical URLs / OG tags.
NEXT_PUBLIC_SITE_URL=https://www.atelierdiesunddas.ch

# Optional: Cloudflare Turnstile for spam-resistant contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
