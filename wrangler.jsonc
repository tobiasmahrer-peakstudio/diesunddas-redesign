{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "atelier-diesunddas",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding, the worker name must match "name" above.
      // See https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "atelier-diesunddas"
    }
  ],
  // Set the same values as in .env.local here via `wrangler secret put`
  // or the Cloudflare dashboard (Settings → Variables & Secrets) —
  // never commit real values into this file.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.atelierdiesunddas.ch"
  }
}
